# OPTIONAL. Everything is normally set up in the browser. Copy to .env only to change these.

# The AI model (downloaded once). Smaller and faster: llama3.2 (default). Apache-licensed: mistral.
# SENTINEL_AGENT_MODEL=llama3.2
# SENTINEL_CHAIRMAN_MODEL=llama3.2

# Remove request text and AI output after this many days (0 = keep). Decisions and reviews stay.
SENTINEL_RETENTION_DAYS=90

# Behind an HTTPS reverse proxy: the proxy's address as the container sees it (marks cookies Secure).
# SENTINEL_FORWARDED_ALLOW_IPS=172.17.0.1

# Jira credentials can be entered in Settings. Setting them here instead overrides the browser:
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PAT=
