# Copy to .env (never commit .env). Read by docker compose and passed to the sentineldesk container.

# Models (pulled once by the model-pull service)
SENTINEL_AGENT_MODEL=llama3.2
SENTINEL_CHAIRMAN_MODEL=llama3.2

# Remove ticket text and model output after this many days (0 = keep). Decisions and reviews stay.
SENTINEL_RETENTION_DAYS=90

# Jira Cloud: an agent account's email and API token (id.atlassian.com > Security > API tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira Data Center: a personal access token instead
# JIRA_PAT=

# FIRST START ONLY: creates the first admin account. Delete both lines after the first start.
SENTINEL_ADMIN_USER=admin
SENTINEL_NEW_PASSWORD=

# Behind an HTTPS reverse proxy: the proxy's address as the container sees it, so session cookies
# are marked Secure. Example for a proxy on the Docker host:
# SENTINEL_FORWARDED_ALLOW_IPS=172.17.0.1
