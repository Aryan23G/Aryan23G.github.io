# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Target database (opened read-only) ---------------------------------------
# Default: the bundled sample warehouse (generated on first start).
# QP_DATABASE_URL=postgresql+psycopg://readonly_user:***@db-host:5432/analytics
# QP_SQL_DIALECT=postgres
# QP_DATABASE_LABEL=analytics
QP_STATEMENT_TIMEOUT_MS=5000
QP_MAX_ROWS=1000

# --- Model ----------------------------------------------------------------------
QP_ANTHROPIC_MODEL=claude-opus-5-5
QP_ANTHROPIC_EFFORT=medium

# --- Agent loop -------------------------------------------------------------------
QP_MAX_STATIC_RETRIES=2
QP_MAX_RUNTIME_RETRIES=2

# --- Schema RAG ---------------------------------------------------------------------
# QP_QDRANT_URL=http://localhost:6333     # server mode (multi-process). Unset = embedded on-disk index.
QP_EMBEDDER=fastembed                      # or "hashing" for fully offline operation
QP_RAG_TOP_K_TABLES=5

# --- Observability ------------------------------------------------------------------
# none | console | otlp | traceloop
QP_OTEL_EXPORTER=none
# Langfuse (OTLP):  QP_OTEL_EXPORTER=otlp
#   QP_OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel
#   QP_OTEL_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
# OpenLLMetry:      QP_OTEL_EXPORTER=traceloop  (+ pip install '.[openllmetry]', TRACELOOP_API_KEY or QP_OTEL_ENDPOINT)
QP_TRACE_CONTENT=false

QP_CORS_ORIGINS=["http://localhost:3000"]
