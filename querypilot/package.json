{
  "name": "querypilot",
  "version": "1.0.0",
  "private": true,
  "description": "Text-to-SQL analytics in the browser: plain-English question -> guarded, read-only SQL -> chart. No API key.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
